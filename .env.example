# Railway injects PORT automatically; 8000 is the local fallback.
PORT=8000

# Set this in production. When present, POST /solve requires the matching
# X-RapidAPI-Proxy-Secret header (RapidAPI injects it automatically).
RAPIDAPI_PROXY_SECRET=

# Hard wall-clock budget for iterative methods, in seconds.
POISSON_TIME_LIMIT_S=10
